<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--固定在底部的布局样式-->
    <style name="PoiDetailFixedStyle">
        <item name="android:layout_height">@dimen/rect_height_medium</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <!-- android:textAppearance="@android:style/TextAppearance.Small"
         android:textColor="@color/poi_detail_loc"-->
    </style>

    <!--TextView相关样式-->
    <style name="BaseTextTheme">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="NormalTextTheme.BaseTextTheme" parent="BaseTextTheme">
        <item name="android:textSize" tools:ignore="SpUsage">16dp</item>
    </style>

    <style name="SmallTextTheme.BaseTextTheme" parent="BaseTextTheme">
        <item name="android:textSize" tools:ignore="SpUsage">14dp</item>
    </style>

</resources>
